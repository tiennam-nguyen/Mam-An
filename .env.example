VITE_APP_ENV=local
VITE_ENABLE_LIVE_AI=false
VITE_ENABLE_PWA=true
VITE_BUILD_ID=local
AI_PROVIDER_ORDER=cohere,huggingface,groq,mistral,openrouter
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b:free
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=mistral-medium-2604
COHERE_API_KEY=
COHERE_VISION_MODEL=command-a-plus-05-2026
HUGGINGFACEHUB_API_KEY=
HUGGINGFACE_VISION_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
# Gemini is opt-in: free-tier content may be used to improve provider products.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
AI_PROVIDER_TIMEOUT_MS=15000
AI_REQUEST_MAX_BYTES=3000000
OPENROUTER_REQUIRE_ZDR=true
OPENROUTER_DENY_DATA_COLLECTION=true

# v0.2 capability settings (text is opt-in; models require explicit configuration)
AI_VISION_ENABLED=true
AI_VISION_MAX_ATTEMPTS=5
AI_TEXT_ENABLED=false
AI_TEXT_PROVIDER_ORDER=groq,mistral
AI_TEXT_TIMEOUT_MS=10000
AI_TEXT_MAX_ATTEMPTS=2
GROQ_TEXT_MODEL=
MISTRAL_TEXT_MODEL=
VITE_ENABLE_TEXT_EXPLANATION=false
