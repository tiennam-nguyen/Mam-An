{
  "name": "mam-an",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run catalog:check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "catalog:build": "tsx scripts/build-food-catalog.ts",
    "catalog:check": "tsx scripts/validate-food-catalog.ts",
    "audit:safety": "tsx scripts/audit-safety-copy.ts",
    "verify:ai": "tsx scripts/verify-ai-models.ts",
    "test:providers": "node --env-file-if-exists=.env.local --import tsx scripts/verify-providers.ts",
    "discover:providers": "node --env-file-if-exists=.env.local --import tsx scripts/discover-providers.ts",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx scripts/dev-api.ts",
    "audit:secrets": "tsx scripts/audit-secrets.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
